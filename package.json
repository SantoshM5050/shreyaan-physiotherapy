{
  "name": "shreyaan-physiotherapy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Monorepo for Shreyaan Physiotherapy Center (Next.js Frontend & Express Backend API)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm start",
    "start:frontend": "npm start --prefix frontend",
    "start:backend": "npm start --prefix backend"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
